# ── Production Environment Configuration Template ──
# Copy to .env or inject as environment variables in your hosting provider

PORT=8085
JWT_SECRET=generate-a-secure-random-64-char-string-in-production

# MySQL Database
MYSQL_USER=creator_prod_user
MYSQL_PASSWORD=replace_with_strong_database_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=creator_platform
MYSQL_DSN=creator_prod_user:replace_with_strong_database_password@tcp(127.0.0.1:3306)/creator_platform?parseTime=true&charset=utf8mb4&loc=Local

# Bird (MessageBird) Email OTP Gateway
BIRD_API_KEY=your_production_bird_api_key_here
BIRD_API_URL=https://eu1.platform.bird.com/v1/email/messages
BIRD_FROM_EMAIL=noreply@yourdomain.com
BIRD_FROM_NAME=Creator Platform

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

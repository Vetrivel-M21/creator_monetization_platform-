# ── Production Environment Configuration Template ──
# Copy to .env on Ubuntu Server (Only ONE port exposed: PORT)

PORT=2085
JWT_SECRET=generate-a-secure-random-64-char-string-in-production

# ARMSS Standard Database Configuration (Ubuntu Host MySQL)
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=creator_platform

# Bird (MessageBird) Email OTP Gateway
BIRD_API_KEY=your_production_bird_api_key_here
BIRD_API_URL=https://eu1.platform.bird.com/v1/email/messages
BIRD_FROM_EMAIL=noreply@yourdomain.com
BIRD_FROM_NAME=Creator Platform

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ==============================================================================
# ARMSS Creator Monetization Platform - Root Git Ignore
# ==============================================================================

# Environment & Sensitive Secrets
.env
.env.local
.env.*.local
*.env
!*.env.example
!*.env.production.example

# Compiled Binaries & Executables
*.exe
*.exe~
*.dll
*.so
*.dylib
backend/creator-monetization-backend.exe
server_test.exe
server_check.exe
server

# Database & Persistent Media Storage
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/creator_platform.db
backend/data/masters/*
!backend/data/masters/.gitkeep
backend/data/hls/*
!backend/data/hls/.gitkeep
backend/data/thumbnails/*
!backend/data/thumbnails/.gitkeep
backend/data/logos/*
!backend/data/logos/.gitkeep
backend/logs/*
!backend/logs/.gitkeep
*.dump
*.sql
*.sql.gz
*.tar.gz

# Node.js & Web Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Flutter & Mobile App
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/android/.gradle
mobile/android/local.properties
mobile/android/app/build
mobile/ios/Flutter/ephemeral/
mobile/ios/Pods/
mobile/windows/flutter/ephemeral/

# IDE & OS Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db


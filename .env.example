# ── Server Configuration ──
PORT=2085
FRONTEND_PORT=2086
JWT_SECRET=super-secret-creator-platform-jwt-token-2026

# ── MySQL Database Configuration (Fallback to SQLite if unconfigured) ──
MYSQL_USER=creator_user
MYSQL_PASSWORD=creator_pass@2026
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=creator_platform
MYSQL_DSN=creator_user:creator_pass@2026@tcp(127.0.0.1:3306)/creator_platform?parseTime=true&charset=utf8mb4&loc=Local

# ── Bird (MessageBird) Email OTP Gateway ──
BIRD_API_KEY=your_bird_api_key_here
BIRD_API_URL=https://eu1.platform.bird.com/v1/email/messages
BIRD_FROM_EMAIL=noreply@arminfo.in
BIRD_FROM_NAME=ARMSS Gateway

# ── Google OAuth 2.0 Credentials ──
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
